source "https://rubygems.org"

# GitHub Pages builds this site with the `github-pages` gem (Jekyll 3.10).
# Using the same gem locally keeps the preview identical to the live site:
#
#     bundle install
#     bundle exec jekyll serve
#
gem "github-pages", group: :jekyll_plugins

# Needed by `jekyll serve` on Ruby 3+
gem "webrick"
